{
  "manifest_version": 3,
  "name": "Духи Духи — инспектор страницы",
  "version": "1.2.4",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "weather-channel.js" },
  "content_scripts": [
    {
      "matches": ["https://animesss.tv/*", "https://animesss.com/*"],
      "css": ["dock.css"],
      "js": ["panel-styles.js", "panel.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://animesss.tv/*", "https://animesss.com/*"],
      "js": ["page-console.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://animesss.tv/*", "https://animesss.com/*", "https://www.animesss.tv/*", "https://www.animesss.com/*"],
      "js": ["weather-layout.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://tauri.localhost/weather-gutters.html"],
      "js": ["weather-mask.js"],
      "run_at": "document_start"
    }
  ]
}
